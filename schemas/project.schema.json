{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "type": "object",
  "properties": {
    "ambient": {
      "$ref": "#/$defs/Ambient"
    },
    "engine": {
      "$ref": "#/$defs/EngineSpec"
    },
    "fabrication": {
      "$ref": "#/$defs/Fabrication",
      "default": {
        "clearance_mm": 25.0,
        "kerf_mm": 3.0,
        "stock_bend_tolerance_deg": 0.5,
        "stock_length_mm": 3048.0
      }
    },
    "gas": {
      "$ref": "#/$defs/GasSpec"
    },
    "inputs": {
      "description": "Provenance, source and range of recorded inputs, keyed by dotted field path (e.g.\n`engine.geometry.bore_mm`, or `system.elements.cat` for a whole element; `inputs`).\nUnrecorded values are the user's own entries.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Input"
      },
      "default": {}
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Material"
      }
    },
    "measurements": {
      "$ref": "#/$defs/Measurements"
    },
    "name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "operating": {
      "$ref": "#/$defs/Operating"
    },
    "receiver": {
      "$ref": "#/$defs/Receiver"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "solver": {
      "$ref": "#/$defs/SolverSettings"
    },
    "system": {
      "$ref": "#/$defs/System"
    },
    "turbine": {
      "$ref": "#/$defs/TurbineSpec"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "engine",
    "turbine",
    "gas",
    "ambient",
    "operating",
    "system",
    "receiver",
    "solver",
    "materials"
  ],
  "$defs": {
    "Alternative": {
      "description": "A value an input has had from another source.",
      "type": "object",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source": {
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "description": "The field's value from this source, in the field's own form."
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "provenance",
        "source"
      ]
    },
    "Ambient": {
      "type": "object",
      "properties": {
        "ground_z_mm": {
          "description": "Height of the ground plane in vehicle coordinates, mm (negative: below the flange).",
          "type": "number",
          "format": "double"
        },
        "pressure_pa": {
          "type": "number",
          "format": "double"
        },
        "temperature_k": {
          "type": "number",
          "format": "double"
        },
        "underbody_air_factor": {
          "description": "Air speed across the pipes as a fraction of vehicle speed (underbody boundary layer).",
          "type": "number",
          "format": "double",
          "default": 0.5
        },
        "vehicle_speed_kmh": {
          "description": "Vehicle speed; sets the external film coefficient in the thermal model.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "pressure_pa",
        "temperature_k",
        "vehicle_speed_kmh",
        "ground_z_mm"
      ]
    },
    "CabinTf": {
      "description": "Cabin transfer function: level at the driver's ear minus level at the exterior receiver.",
      "type": "object",
      "properties": {
        "gain_db": {
          "description": "`[[frequency_hz, gain_db], …]`, frequency increasing; linear between points, undefined\noutside them.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 2,
            "minItems": 2
          }
        },
        "method": {
          "$ref": "#/$defs/CabinTfMethod"
        },
        "source": {
          "description": "Where and when it was measured.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "method",
        "source",
        "gain_db"
      ]
    },
    "CabinTfMethod": {
      "oneOf": [
        {
          "description": "Exterior and interior recordings at the same cruise point; ratio per engine order.",
          "type": "string",
          "const": "order_ratio"
        },
        {
          "description": "Impulse response: clap or balloon at the tailpipe, phone at the driver's ear.",
          "type": "string",
          "const": "impulse"
        }
      ]
    },
    "ClearanceZone": {
      "description": "A stretch along the car, `x_min_mm ≤ x ≤ x_max_mm`, with its own clearance.",
      "type": "object",
      "properties": {
        "clearance_mm": {
          "type": "number",
          "format": "double"
        },
        "name": {
          "type": "string"
        },
        "x_max_mm": {
          "type": "number",
          "format": "double"
        },
        "x_min_mm": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "x_min_mm",
        "x_max_mm",
        "clearance_mm"
      ]
    },
    "Element": {
      "description": "Element types and their parameters. Port names are fixed per type (see\n[`ElementKind::port_names`]); pipes attach to ports by name.",
      "type": "object",
      "properties": {
        "axis": {
          "description": "Flow direction through the element (normalised on use).",
          "type": "array",
          "default": [
            -1.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "id": {
          "type": "string"
        },
        "position_mm": {
          "description": "Position of the element's first port, mm.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "oneOf": [
        {
          "description": "Engine and turbine; port `out` is the downpipe flange face.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "source"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Unflanged tailpipe tip radiating to atmosphere; port `in`.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "outlet"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Joins two pipes of different bore: sudden when `taper_length_mm` is 0, otherwise a\ncone of that length. Ports `in`, `out`; bores come from the connected pipes.",
          "type": "object",
          "properties": {
            "taper_length_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "area_change"
            }
          },
          "required": [
            "type",
            "taper_length_mm"
          ]
        },
        {
          "description": "Closed pipe end; port `in`.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cap"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Simple expansion chamber (reactive muffler) with optional inlet and outlet tubes extending\ninto it. Ports: `in` at `position_mm`, `out` at `position_mm + axis·length_mm`, and `out2`,\n`out3`, … at `extra_outlets_mm` (offsets from `out`) for multi-outlet mufflers. Pipe bores\ncome from the connected routes.",
          "type": "object",
          "properties": {
            "diameter_mm": {
              "description": "Inner diameter of the shell, mm.",
              "type": "number",
              "format": "double"
            },
            "extra_outlets_mm": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 3,
                "minItems": 3
              }
            },
            "inlet_extension_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "length_mm": {
              "type": "number",
              "format": "double"
            },
            "outlet_extension_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "shell_mm": {
              "description": "Shell thickness, mm (heat loss and fabrication).",
              "type": "number",
              "format": "double",
              "default": 1.2
            },
            "type": {
              "type": "string",
              "const": "expansion_chamber"
            }
          },
          "required": [
            "type",
            "diameter_mm",
            "length_mm"
          ]
        },
        {
          "description": "Closed side branch (quarter-wave resonator) teed onto the main pipe. Ports `in` and `out`\nboth at `position_mm`; the branch leaves along `direction`.",
          "type": "object",
          "properties": {
            "direction": {
              "type": "array",
              "default": [
                0.0,
                0.0,
                -1.0
              ],
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "id_mm": {
              "type": "number",
              "format": "double"
            },
            "length_mm": {
              "description": "Physical length from the main-pipe wall to the cap, mm.",
              "type": "number",
              "format": "double"
            },
            "material": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "quarter_wave_stub"
            },
            "wall_mm": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "type",
            "id_mm",
            "wall_mm",
            "length_mm",
            "material"
          ]
        },
        {
          "description": "Helmholtz resonator teed onto the main pipe: a neck into a cylindrical cavity. Ports `in`\nand `out` both at `position_mm`; the neck leaves along `direction`.",
          "type": "object",
          "properties": {
            "cavity_diameter_mm": {
              "type": "number",
              "format": "double"
            },
            "direction": {
              "type": "array",
              "default": [
                0.0,
                0.0,
                -1.0
              ],
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "neck_id_mm": {
              "type": "number",
              "format": "double"
            },
            "neck_length_mm": {
              "description": "Physical neck length, mm.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "helmholtz"
            },
            "volume_l": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "type",
            "neck_id_mm",
            "neck_length_mm",
            "volume_l",
            "cavity_diameter_mm"
          ]
        },
        {
          "description": "Monolith catalyst: inlet cone, brick of square channels, outlet cone. Ports `in` at\n`position_mm` and `out` at `position_mm + axis·(inlet cone + brick + outlet cone)`.",
          "type": "object",
          "properties": {
            "brick_diameter_mm": {
              "type": "number",
              "format": "double"
            },
            "brick_length_mm": {
              "type": "number",
              "format": "double"
            },
            "cell_wall_mm": {
              "description": "Cell wall thickness, mm (4 mil = 0.1016 mm).",
              "type": "number",
              "format": "double"
            },
            "cpsi": {
              "description": "Cells per square inch.",
              "type": "number",
              "format": "double"
            },
            "inlet_cone_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "outlet_cone_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "type": {
              "type": "string",
              "const": "catalyst"
            }
          },
          "required": [
            "type",
            "cpsi",
            "cell_wall_mm",
            "brick_length_mm",
            "brick_diameter_mm"
          ]
        },
        {
          "description": "Butterfly valve (electric cutout or exhaust flap). Ports `in` and `out` at `position_mm`.",
          "type": "object",
          "properties": {
            "angle_deg": {
              "description": "Disc opening: 0° closed, 90° fully open.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "valve"
            }
          },
          "required": [
            "type",
            "angle_deg"
          ]
        },
        {
          "description": "Tee or wye junction. Ports `in`, `out` and `branch`, all at `position_mm`.",
          "type": "object",
          "properties": {
            "branch_direction": {
              "type": "array",
              "default": [
                0.0,
                0.0,
                -1.0
              ],
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "type": {
              "type": "string",
              "const": "tee"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Absorptive straight-through muffler: perforated tube of the pipe bore inside a cylindrical\ncase; the annulus is packed with fibre (or empty: a concentric-tube resonator). Ports `in`\nat `position_mm` and `out` at `position_mm + axis·length_mm`.",
          "type": "object",
          "properties": {
            "case_diameter_mm": {
              "description": "Inner diameter of the case, mm.",
              "type": "number",
              "format": "double"
            },
            "fiber_diameter_um": {
              "description": "Fibre diameter, µm (basalt or glass wool ≈ 10–13 µm).",
              "type": "number",
              "format": "double",
              "default": 12.0
            },
            "fill_density_kg_m3": {
              "description": "Packing density, kg/m³ (0: empty annulus).",
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "hole_diameter_mm": {
              "type": "number",
              "format": "double"
            },
            "length_mm": {
              "type": "number",
              "format": "double"
            },
            "open_area_ratio": {
              "description": "Open-area ratio of the perforated tube.",
              "type": "number",
              "format": "double"
            },
            "perforate_thickness_mm": {
              "description": "Perforated tube wall, mm.",
              "type": "number",
              "format": "double"
            },
            "shell_mm": {
              "type": "number",
              "format": "double",
              "default": 1.2
            },
            "type": {
              "type": "string",
              "const": "absorptive"
            }
          },
          "required": [
            "type",
            "case_diameter_mm",
            "length_mm",
            "open_area_ratio",
            "hole_diameter_mm",
            "perforate_thickness_mm"
          ]
        }
      ],
      "required": [
        "id",
        "position_mm"
      ]
    },
    "EngineGeometry": {
      "description": "Slider-crank geometry and firing order.",
      "type": "object",
      "properties": {
        "bore_mm": {
          "description": "Bore, mm.",
          "type": "number",
          "format": "double"
        },
        "compression_ratio": {
          "description": "Geometric compression ratio.",
          "type": "number",
          "format": "double"
        },
        "firing_order": {
          "description": "Firing order, 1-based cylinder numbers. Four-stroke: cylinders fire at equal intervals\nof 720°/n.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "rod_mm": {
          "description": "Connecting-rod centre distance, mm.",
          "type": "number",
          "format": "double"
        },
        "stroke_mm": {
          "description": "Stroke, mm.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "bore_mm",
        "stroke_mm",
        "rod_mm",
        "compression_ratio",
        "firing_order"
      ]
    },
    "EngineSpec": {
      "type": "object",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/EngineGeometry"
        },
        "label": {
          "type": "string"
        },
        "polytropic_exponent": {
          "description": "Polytropic exponent of the cylinder gas after EVO.",
          "type": "number",
          "format": "double"
        },
        "valves": {
          "$ref": "#/$defs/ExhaustValves"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "geometry",
        "valves",
        "polytropic_exponent"
      ]
    },
    "EvoState": {
      "description": "In-cylinder state at exhaust valve opening.",
      "type": "object",
      "properties": {
        "pressure_pa": {
          "description": "Pa.",
          "type": "number",
          "format": "double"
        },
        "temperature_k": {
          "description": "K.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "pressure_pa",
        "temperature_k"
      ]
    },
    "ExhaustValves": {
      "description": "Exhaust valve train of one cylinder.",
      "type": "object",
      "properties": {
        "discharge_coefficient": {
          "description": "Discharge coefficient referred to the geometric flow area.",
          "type": "number",
          "format": "double"
        },
        "evc_deg": {
          "description": "Exhaust valve closing, crank degrees after firing TDC (e.g. 370 = 10° after gas-exchange TDC).",
          "type": "number",
          "format": "double"
        },
        "evo_deg": {
          "description": "Exhaust valve opening, crank degrees after firing TDC.",
          "type": "number",
          "format": "double"
        },
        "lift_table": {
          "description": "Measured lift curve: (crank degrees after firing TDC, lift mm), linearly interpolated.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 2,
            "minItems": 2
          }
        },
        "max_lift_mm": {
          "description": "Peak lift, mm, of the raised-cosine profile `L = L_max (1 − cos 2πφ)/2`,\n`φ = (θ − EVO)/(EVC − EVO)`. Ignored when `lift_table` is given.",
          "type": "number",
          "format": "double"
        },
        "throat_diameter_mm": {
          "description": "Port throat (inner seat) diameter, mm; caps the flow area at π d²/4 per valve.",
          "type": "number",
          "format": "double"
        },
        "valve_diameter_mm": {
          "description": "Valve head diameter, mm (curtain area π d L).",
          "type": "number",
          "format": "double"
        },
        "valves_per_cylinder": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "valves_per_cylinder",
        "valve_diameter_mm",
        "throat_diameter_mm",
        "discharge_coefficient",
        "evo_deg",
        "evc_deg",
        "max_lift_mm"
      ]
    },
    "Fabrication": {
      "description": "Fabrication settings: stock, cutting, and underbody clearance.",
      "type": "object",
      "properties": {
        "clearance_mm": {
          "description": "Gap wanted between pipe surface and underbody, mm.",
          "type": "number",
          "format": "double",
          "default": 25.0
        },
        "clearance_zones": {
          "description": "Stretches that need a different gap (near the rear axle, say).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClearanceZone"
          }
        },
        "kerf_mm": {
          "description": "Saw kerf per cut, mm.",
          "type": "number",
          "format": "double",
          "default": 3.0
        },
        "scan": {
          "description": "Underbody scan and where it sits on the car.",
          "anyOf": [
            {
              "$ref": "#/$defs/Scan"
            },
            {
              "type": "null"
            }
          ]
        },
        "stock_bend_tolerance_deg": {
          "description": "A stock 45° or 90° mandrel bend is used uncut within this angle, degrees.",
          "type": "number",
          "format": "double",
          "default": 0.5
        },
        "stock_length_mm": {
          "description": "Straight tube is bought in lengths of, mm (10 ft).",
          "type": "number",
          "format": "double",
          "default": 3048.0
        }
      },
      "additionalProperties": false
    },
    "GasSpec": {
      "type": "object",
      "properties": {
        "fuel_h_to_c": {
          "description": "Fuel hydrogen-to-carbon atom ratio (gasoline ≈ 1.87).",
          "type": "number",
          "format": "double"
        },
        "lambda": {
          "description": "Air-excess ratio λ (≥ 1).",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "fuel_h_to_c",
        "lambda"
      ]
    },
    "Input": {
      "description": "The recorded origin of one input.",
      "type": "object",
      "properties": {
        "alternatives": {
          "description": "Values this input has had from other sources.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alternative"
          }
        },
        "chosen": {
          "description": "The user chose the value in the field over alternatives of higher precedence.",
          "type": "boolean"
        },
        "provenance": {
          "description": "Provenance of the value in the field.",
          "$ref": "#/$defs/Provenance"
        },
        "source": {
          "description": "File, citation, or estimation method.",
          "type": "string"
        },
        "uncertainty": {
          "description": "Stated range; absent: the default range of the input's class.",
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "provenance",
        "source"
      ]
    },
    "Joint": {
      "description": "How two parts are joined.",
      "type": "string",
      "enum": [
        "butt",
        "slip",
        "v_band",
        "flange"
      ]
    },
    "Limiter": {
      "description": "TVD slope limiter for MUSCL reconstruction of primitive variables.",
      "oneOf": [
        {
          "description": "`minmod(a, b)`: most dissipative TVD limiter.",
          "type": "string",
          "const": "minmod"
        },
        {
          "description": "van Leer (1974): `2ab/(a + b)` when `ab > 0`.",
          "type": "string",
          "const": "van_leer"
        },
        {
          "description": "van Leer with a TVB bound (Shu 1987): where both one-sided differences are below\n`gas1d::TVB_BOUND` of the local ρ, c or p the profile is treated as smooth and\nreconstructed unlimited with the third-order upwind-biased MUSCL κ = 1/3 formula;\nelsewhere (engine pulses, shocks, contact jumps) the van Leer limiter applies. Strict\nTVD limiters flatten every acoustic extremum; over 2 m of pipe at Δx = 15 mm and 19 cells\nper wavelength van Leer loses 10 dB at 1.2 kHz, this variant 2 dB (0.2 dB in exhaust gas).",
          "type": "string",
          "const": "van_leer_tvb"
        }
      ]
    },
